	data_b[1] = #100000 1'b0;
	data_b[1] = #100000 1'b1;
	data_b[1] = #100000 1'b0;
	data_b[1] = #100000 1'b1;
	data_b[1] = #200000 1'b0;
	data_b[1] = #100000 1'b1;
end 
// data_b[ 0 ]
initial
begin
	data_b[0] = 1'b0;
	data_b[0] = #100000 1'b1;
	data_b[0] = #200000 1'b0;
	data_b[0] = #200000 1'b1;
	data_b[0] = #100000 1'b0;
	data_b[0] = #300000 1'b1;
end 

RP_from_template_vlg_sample_tst tb_sample (
	.addr_a(addr_a),
	.addr_b(addr_b),
	.clk(clk),
	.data_a(data_a),
	.data_b(data_b),
	.we_a(we_a),
	.we_b(we_b),
	.sampler_tx(sampler)
);

RP_from_template_vlg_check_tst tb_out(
	.q_a(q_a),
	.q_b(q_b),
	.sampler_rx(sampler)
);
endmodule

