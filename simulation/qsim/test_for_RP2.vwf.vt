`timescale 1 ps/ 1 ps
module RP_from_template_vlg_sample_tst(
	addr_a,
	addr_b,
	clk,
	data_a,
	data_b,
	we_a,
	we_b,
	sampler_tx
);
input [2:0] addr_a;
input [2:0] addr_b;
input  clk;
input [7:0] data_a;
input [7:0] data_b;
input  we_a;
input  we_b;
output sampler_tx;

reg sample;
time current_time;
always @(addr_a or addr_b or clk or data_a or data_b or we_a or we_b)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

